{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "scripts/**/*.ts",
    "playwright.config.ts",
    "playwright/fixtures/**/*.ts",
    "playwright/tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
