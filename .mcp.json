{
  "mcpServers": {
    "playwright-user": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--user-data-dir",
        "playwright/.mcp-browsers/user",
        "--storage-state",
        "playwright/.auth/user-session.json",
        "--port",
        "3101"
      ]
    },
    "playwright-plugin": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--user-data-dir",
        "playwright/.mcp-browsers/plugin",
        "--storage-state",
        "playwright/.auth/plugin-session.json",
        "--port",
        "3102"
      ]
    }
  }
}
